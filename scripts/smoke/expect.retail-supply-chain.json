  "soft": {
    "top": {
      ".hero-canvas canvas": 1
    }
  },
  "live": {
    "top": [
      {
        "sel": ".hero-stats .stat:nth-child(1) b",
        "minNumber": 1,
        "what": "events/sec on this page"
      },
      {
        "sel": ".hero-stats .stat:nth-child(3) b",
        "minNumber": 1,
        "what": "orders through the mesh"
      }
    ],
    "flow": [
      {
        "sel": ".arch-log-row",
        "minCount": 3,
        "what": "live topic log"
      },
      {
        "sel": ".arch-svg circle[filter]",
        "minCount": 1,
        "what": "particles on the bus"
      }
    ],
    "topics": [
      {
        "sel": ".topic-stats > div:nth-child(1) b",
        "minNumber": 10,
        "what": "events seen"
      },
      {
        "sel": ".srow.hit",
        "minCount": 1,
        "what": "delivered rows for the default subscription"
      }
    ],
    "wan": [
      {
        "sel": ".wan-hud > div:nth-child(2) b",
        "minNumber": 1,
        "what": "events across WAN"
      }
    ],
    "throughput": [
      {
        "sel": ".tp-count span",
        "minNumber": 1000,
        "what": "msgs/sec counter"
      }
    ],
    "kafka": [
      {
        "sel": ".kb-row:not(.kb-head)",
        "minCount": 1,
        "what": "blotter rows"
      },
      {
        "sel": ".kb-kpis div:nth-child(1) b",
        "minNumber": 1,
        "what": "records on Kafka"
      },
      {
        "sel": ".kb-map",
        "minCount": 1,
        "what": "bridge mappings"
      }
    ],
    "global": [
      {
        "sel": ".gd-row",
        "minCount": 1,
        "what": "desk rows"
      },
      {
        "sel": ".gd-stats div:nth-child(2) b",
        "minNumber": 1,
        "what": "events delivered"
      }
    ],
    "blotter": [
      {
        "sel": ".ob-row:not(.ob-head)",
        "minCount": 1,
        "what": "order rows"
      },
      {
        "sel": ".mw tbody td[colspan]",
        "maxCount": 0,
        "what": "every SKU has a level"
      },
      {
        "sel": ".mw .inv-bar",
        "minCount": 18,
        "what": "inventory level bars"
      }
    ]
  },
  "interact": {
    "topicRouting": {
      "sub": "retail/stock/>",
      "everyDeliveredContains": "retail/stock/"
    },
    "kafka": {
      "chip": "ELECTRONICS",
      "expectSub": "retail/stock/*/*/electronics/*/*",
      "allowedVenues": [
        "NYC-01",
        "CHI-03",
        "LAX-05",
        "BER-08"
      ],
      "keyChip": "store",
      "topics": 2
    },
    "throughput": {
      "slider": 20,
      "expectApprox": 2400000,
      "tolerance": 0.08
    },
    "blotter": {
      "chip": "web",
      "expectSub": "retail/order/*/*/web/>",
      "deskColumn": 2
    }
  },
  "ignoreConsole": []
}
